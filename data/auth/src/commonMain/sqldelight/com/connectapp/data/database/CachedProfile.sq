CREATE TABLE CachedProfileEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    firstName TEXT NOT NULL,
    lastName TEXT NOT NULL,
    email TEXT NOT NULL,
    phone TEXT NOT NULL,
    fetchedAt INTEGER NOT NULL
);

select:
SELECT *
FROM CachedProfileEntity
WHERE id = 0;

upsert:
INSERT OR REPLACE INTO CachedProfileEntity(id, firstName, lastName, email, phone, fetchedAt)
VALUES (0, ?, ?, ?, ?, ?);

clear:
DELETE FROM CachedProfileEntity;
